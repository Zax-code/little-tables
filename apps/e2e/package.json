    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@e2e-dev/web": "^0.13.0",
    "@types/node": "^26.6.4",
    "ai": "^7.0.128",
    "e2e": "^0.18.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
