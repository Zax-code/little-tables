[Unit]
Description=Little Tables MongoDB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
TimeoutStartSec=0
ExecStartPre=-/usr/bin/podman rm -f little-tables-mongo
ExecStart=/usr/bin/podman run --name little-tables-mongo --rm --pull=never --publish 127.0.0.1:27018:27017 --volume little-tables-mongo-data:/data/db docker.io/library/mongo:7.0.17
ExecStop=/usr/bin/podman stop --time 10 little-tables-mongo

[Install]
WantedBy=multi-user.target
