[Unit]
Description=Little Tables PWA and API
After=little-tables-mongo.container
Requires=little-tables-mongo.container

[Container]
Image=@LITTLE_TABLES_IMAGE@
ContainerName=little-tables-app
EnvironmentFile=/etc/little-tables/little-tables.env
Network=host
Pull=never
StopTimeout=15

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
