[Unit]
Description=Little Tables MongoDB

[Container]
Image=docker.io/library/mongo:7.0.17
ContainerName=little-tables-mongo
PublishPort=127.0.0.1:27018:27017
Pull=never
StopTimeout=10
Volume=little-tables-mongo-data.volume:/data/db
Memory=1g
PidsLimit=512

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
