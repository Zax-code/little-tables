#!/usr/bin/env bash
set -euo pipefail

readonly command=${SSH_ORIGINAL_COMMAND:-}

case "$command" in
  deploy-release\ *)
    # deploy-release <commit> <sha256>, with the release archive on standard input.
    read -r _ revision checksum extra <<<"$command"
    [[ $revision =~ ^[0-9a-f]{40}$ && $checksum =~ ^[0-9a-f]{64}$ && -z ${extra:-} ]] || exit 2
    exec sudo /usr/local/sbin/deploy-little-tables-release "$revision" "$checksum"
    ;;
  status)
    exec sudo /usr/bin/systemctl status little-tables.service --no-pager
    ;;
  public-health)
    for _ in {1..20}; do
      if curl --user-agent 'Mozilla/5.0 little-tables-deployment' --fail --silent --show-error --max-time 5 https://math.leaetzak.love/health/ready; then
        exit 0
      fi
      sleep 3
    done
    exit 1
    ;;
  *)
    echo 'This key is restricted to Little Tables deployments.' >&2
    exit 2
    ;;
esac
