# Variables of the Rust server (crates/lt-server/src/config.rs). Development needs none of them:
# without LT_ENV it uses a local database and, with AUTH_MODE=disabled, no Google sign-in.
LT_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/little-tables/little-tables.db
WEB_DIST_PATH=/opt/little-tables/current/web
PUBLIC_ORIGIN=https://math.leaetzak.love
SESSION_SECRET=replace-with-at-least-32-random-bytes
GOOGLE_CLIENT_ID=replace-with-your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_EMAILS=first-parent@example.com,second-parent@example.com
ADMIN_EMAILS=owner@example.com
VAPID_PUBLIC_KEY=replace-with-a-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-a-vapid-private-key
VAPID_SUBJECT=https://math.leaetzak.love
