{
  "name": "little-tables",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:rust && pnpm test && pnpm validate:quadlets && pnpm build",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "dev": "pnpm --filter @little-tables/app dev",
    "dev:server": "AUTH_MODE=disabled cargo run -p lt-server -- serve",
    "doctor": "react-doctor apps/app --yes",
    "e2e": "pnpm --filter @little-tables/e2e e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @little-tables/engine build:wasm && eslint .",
    "test": "pnpm -r --if-present test && pnpm test:assets && pnpm test:deployment",
    "test:assets": "python3 -m unittest discover -s tools/asset-pipeline -p 'test_*.py'",
    "test:deployment": "python3 -m unittest discover -s tools/deployment -p 'test_*.py'",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate:quadlets": "bash tools/validate-quadlets.sh",
    "smoke:release": "bash tools/smoke-release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.5",
    "react-doctor": "0.7.8",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
