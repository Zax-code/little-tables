{
  "name": "little-tables",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm validate:quadlets && pnpm build",
    "dev": "pnpm --filter @little-tables/web dev",
    "dev:server": "pnpm --filter @little-tables/server dev",
    "doctor": "react-doctor apps/web --yes",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "smoke:docker": "sh tools/smoke-docker.sh",
    "test": "pnpm -r --if-present test && pnpm test:assets && pnpm test:deployment",
    "test:assets": "python3 -m unittest discover -s tools/asset-pipeline -p 'test_*.py'",
    "test:deployment": "python3 -m unittest discover -s tools/deployment -p 'test_*.py'",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate:quadlets": "bash tools/validate-quadlets.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.9.0",
    "prettier": "^3.9.6",
    "react-doctor": "0.9.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
