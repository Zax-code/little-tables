{
  "name": "@little-tables/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Effect facade of the Rust learning engine compiled to WebAssembly.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./wasm/*": "./wasm/*"
  },
  "scripts": {
    "build:wasm": "bash ../../tools/build-wasm.sh",
    "build": "tsc -p tsconfig.build.json",
    "pretest": "pnpm build:wasm",
    "test": "vitest run",
    "pretypecheck": "pnpm build:wasm",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
